# ==========================================
# .gitignore
# نظام إدارة الأشغال والخدمات الهندسية - بلدية كفرنجة
# ==========================================

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment & Credentials
.env
.env.local
.env.development
.env.production
*.pem
*.key
*.cert

# Logs & Operating Data
logs/*.log
backups/*.sql
backups/*.tar.gz
backups/*.enc

# Database Binaries
database/*.mdb
database/*.ldb
*.sqlite
*.db

# Temporary & Build Output
tmp/
temp/
bin/
obj/
uploads/*
!uploads/.gitkeep
dist/
build/
.ds_store
Thumbs.db
.agents/
.vscode/
