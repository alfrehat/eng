// ─────────────────────────────────────────────────────────────────────────────
// 4. POST / - Create or Update Template
// ─────────────────────────────────────────────────────────────────────────────
router.post(['/', '/visual-save'], requireAuth, async (req, res) => {
  try {
    const {
      id,
      name,
      module,
      category_ar,
      description,
      orientation,
      is_default,
      html_template,
      htmlTemplate,
      signatures_config,
      header_config,
      footer_config
    } = req.body;

    const templateContent = html_template || htmlTemplate;
    if (!templateContent || !templateContent.trim()) {
      return res.status(400).json({ success: false, error: 'يرجى إدخال محتوى وتصميم القالب قبل الحفظ' });
    }

    const templateId = id ? String(id).trim() : `TMPL-${Date.now().toString(36).toUpperCase()}`;
    const list = getLocalTemplates();

    const categoryMap = {
      LETTER: 'الكتب الرسمية والمخاطبات',
      TENDERS: 'العطاءات والمشاريع',
      CLAIMS: 'المطالبات والمالية',
      COMMITTEES: 'تقارير اللجان والاستلام',
      PERMITS: 'تصاريح الحفر وتزويد الخدمات',
      PAVING: 'عوائد التعبيد والتحققات',
      ROADS: 'شبكة الطرق والقياس الجغرافي',
      CONTRACTS: 'العقود والضمانات'
    };

    const targetModule = module || 'LETTER';
    const targetIsDefault = is_default === true || is_default === 'true';

    if (targetIsDefault) {
      list.forEach(t => {
        if (t.module === targetModule) t.is_default = false;
      });
    }

    const templateItem = {
      id: templateId,
      name: name || 'قالب رسمي معتمد',
      module: targetModule,
      category_ar: category_ar || categoryMap[targetModule] || targetModule,
      description: description || 'قالب طباعة معتمد لبلدية كفرنجة الجديدة.',
      orientation: orientation === 'landscape' ? 'landscape' : 'portrait',
      is_default: targetIsDefault,
      html_template: templateContent,
      signatures_config: Array.isArray(signatures_config) ? signatures_config : undefined,
      header_config: header_config || {},
      footer_config: footer_config || {},
      updated_at: new Date().toISOString()
    };

    const existingIdx = list.findIndex(t => t.id === templateId);
    if (existingIdx >= 0) {
      list[existingIdx] = { ...list[existingIdx], ...templateItem };
    } else {
      list.unshift(templateItem);
    }

    saveLocalTemplates(list);

    if (isPostgresActive()) {
      try {
        await dbRun(`
          INSERT INTO enterprise.print_templates (id, name, module, html_template, is_default, updated_at)
          VALUES ($1, $2, $3, $4, $5, NOW())
          ON CONFLICT (id) DO UPDATE SET
            name = EXCLUDED.name,
            module = EXCLUDED.module,
            html_template = EXCLUDED.html_template,
            is_default = EXCLUDED.is_default,
            updated_at = NOW()
        `, [templateId, templateItem.name, templateItem.module, templateItem.html_template, templateItem.is_default]);
      } catch (dbErr) {
        console.warn('⚠️ Postgres print_templates save fallback to JSON');
      }
    }

    res.json({
      success: true,
      message: 'تم حفظ وتعميم قالب الطباعة بنجاح',
      data: templateItem
    });
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});

// ─────────────────────────────────────────────────────────────────────────────
// 5. PUT /:id/default - Set template as default for its module
// ─────────────────────────────────────────────────────────────────────────────
router.put('/:id/default', requireAuth, async (req, res) => {
  try {
    const list = getLocalTemplates();
    const item = list.find(t => t.id === req.params.id);
    if (!item) {
      return res.status(404).json({ success: false, error: 'القالب غير موجود' });
    }

    list.forEach(t => {
      if (t.module === item.module) t.is_default = false;
    });
    item.is_default = true;
    item.updated_at = new Date().toISOString();

    saveLocalTemplates(list);

    if (isPostgresActive()) {
      try {
        await dbRun('UPDATE enterprise.print_templates SET is_default = false WHERE module = $1', [item.module]);
        await dbRun('UPDATE enterprise.print_templates SET is_default = true, updated_at = NOW() WHERE id = $1', [item.id]);
      } catch (dbErr) {}
    }

    res.json({ success: true, message: `تم تعيين القالب (${item.name}) كافتراضي لموديول ${item.category_ar || item.module}`, data: item });
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});

// ─────────────────────────────────────────────────────────────────────────────
// 6. POST /:id/duplicate - Clone template
// ─────────────────────────────────────────────────────────────────────────────
router.post('/:id/duplicate', requireAuth, async (req, res) => {
  try {
    const list = getLocalTemplates();
    const source = list.find(t => t.id === req.params.id);
    if (!source) {
      return res.status(404).json({ success: false, error: 'القالب الأصلي غير موجود' });
    }

    const dup = {
      ...JSON.parse(JSON.stringify(source)),
      id: 'TMPL-' + Date.now().toString(36).toUpperCase(),
      name: `${source.name} (نسخة مخصصة)`,
      is_default: false,
      updated_at: new Date().toISOString()
    };

    list.unshift(dup);
    saveLocalTemplates(list);

    res.json({ success: true, message: 'تم نسخ القالب بنجاح', data: dup });
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});

// ─────────────────────────────────────────────────────────────────────────────
// 7. DELETE /:id - Delete custom template
// ─────────────────────────────────────────────────────────────────────────────
router.delete('/:id', requireAuth, async (req, res) => {
  try {
    const list = getLocalTemplates();
    const item = list.find(t => t.id === req.params.id);
    if (!item) {
      return res.status(404).json({ success: false, error: 'القالب غير موجود' });
    }

    if (item.is_default && String(item.id).startsWith('TMPL-')) {
      return res.status(400).json({ success: false, error: 'لا يمكن حذف القالب الافتراضي الأساسي للنظام' });
    }

    const updated = list.filter(t => t.id !== req.params.id);
    saveLocalTemplates(updated);

    if (isPostgresActive()) {
      try {
        await dbRun('DELETE FROM enterprise.print_templates WHERE id = $1', [req.params.id]);
      } catch (dbErr) {}
    }

    res.json({ success: true, message: 'تم حذف القالب بنجاح' });
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});

