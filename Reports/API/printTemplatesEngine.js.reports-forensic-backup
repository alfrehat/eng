/**
 * Reports/API/printTemplatesEngine.js
 * محرك وخادم قوالب النماذج والطباعة الرسمية
 * بلدية كفرنجة الجديدة - مديرية الأشغال والخدمات الهندسية
 */

const express = require('express');
const router = express.Router();
const fs = require('fs');
const path = require('path');
const { requireAuth, requireAdmin } = require('../../middlewares/authMiddleware');
const { isPostgresActive, dbQuery, dbRun, memDb } = require('../../utils/database');

const jsonPath = path.join(__dirname, '../../database/print_templates.json');

function getLocalTemplates() {
  try {
    if (fs.existsSync(jsonPath)) {
      const data = fs.readFileSync(jsonPath, 'utf8');
      return JSON.parse(data || '[]');
    }
  } catch (e) {
    console.error('Error reading print_templates.json:', e);
  }
  return [];
}

function saveLocalTemplates(list) {
  try {
    const dir = path.dirname(jsonPath);
    if (!fs.existsSync(dir)) fs.mkdirSync(dir, { recursive: true });
    fs.writeFileSync(jsonPath, JSON.stringify(list, null, 2), 'utf8');
    if (memDb) memDb['print_templates'] = list;
    return true;
  } catch (e) {
    console.error('Error saving print_templates.json:', e);
    return false;
  }
}

// ─────────────────────────────────────────────────────────────────────────────
// 1. GET /stats - Analytics & Template KPIs
// ─────────────────────────────────────────────────────────────────────────────
router.get(['/stats', '/analytics'], async (req, res) => {
  try {
    const templates = getLocalTemplates();
    const total = templates.length;
    const defaultCount = templates.filter(t => t.is_default).length;
    const customCount = templates.filter(t => !String(t.id).startsWith('TMPL-')).length;
    const modulesSet = new Set(templates.map(t => t.module));

    const moduleBreakdown = {};
    templates.forEach(t => {
      moduleBreakdown[t.module] = (moduleBreakdown[t.module] || 0) + 1;
    });

    res.json({
      success: true,
      data: {
        total,
        defaultCount,
        customCount,
        modulesCount: modulesSet.size,
        moduleBreakdown
      }
    });
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});

// ─────────────────────────────────────────────────────────────────────────────
// 2. GET / - List all templates with filtering & search
// ─────────────────────────────────────────────────────────────────────────────
router.get('/', async (req, res) => {
  try {
    let list = getLocalTemplates();

    if (isPostgresActive()) {
      try {
        const pgRows = await dbQuery('SELECT * FROM enterprise.print_templates ORDER BY is_default DESC, updated_at DESC');
        if (pgRows && pgRows.length > 0) {
          const map = new Map();
          list.forEach(t => map.set(t.id, t));
          pgRows.forEach(r => map.set(r.id, { ...map.get(r.id), ...r }));
          list = Array.from(map.values());
        }
      } catch (dbErr) {
        // fallback to local list
      }
    }

    const { module, is_default, search } = req.query;

    if (module && module !== 'ALL') {
      list = list.filter(t => t.module === module);
    }
    if (is_default !== undefined) {
      const isDef = is_default === 'true' || is_default === '1';
      list = list.filter(t => !!t.is_default === isDef);
    }
    if (search) {
      const q = String(search).toLowerCase().trim();
      list = list.filter(t =>
        (t.name && t.name.toLowerCase().includes(q)) ||
        (t.id && t.id.toLowerCase().includes(q)) ||
        (t.category_ar && t.category_ar.toLowerCase().includes(q)) ||
        (t.description && t.description.toLowerCase().includes(q))
      );
    }

    res.json({ success: true, count: list.length, data: list });
  } catch (err) {
    res.status(500).json({ success: false, error: err.message });
  }
});

