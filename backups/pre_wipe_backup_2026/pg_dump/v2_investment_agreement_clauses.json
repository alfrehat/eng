[
  {
    "clause_id": "cls_1788615939966_xywx",
    "agreement_id": "6f96a289-7a19-4be0-bbac-946c04d87c74",
    "clause_number": "CLAUSE-01",
    "section_title": "أحكام تمهيدية",
    "clause_title": "موضوع العقد والغرض الاستثماري",
    "clause_content": "اتفق الطرفان على قيام المستثمر بتنفيذ واستثمار المشروع على الأصل رقم (INV-ASSET-2026-0001) طبقاً للشروط والمواصفات الفنية.",
    "is_mandatory": true,
    "order_index": 1,
    "created_by": "legal_officer",
    "created_at": "2026-09-05T13:45:39.967Z",
    "updated_by": "legal_officer",
    "updated_at": "2026-09-05T13:45:39.967Z",
    "version": 1,
    "is_deleted": false
  },
  {
    "clause_id": "cls_1788615939973_vqw8",
    "agreement_id": "6f96a289-7a19-4be0-bbac-946c04d87c74",
    "clause_number": "CLAUSE-02",
    "section_title": "الالتزامات المالية",
    "clause_title": "بدل الاستثمار ونسب المشاركة",
    "clause_content": "يلتزم المستثمر بسداد حصة البلدية المقررة بنسبة (20%) سنوياً من إجمالي الإيراد بالإضافة إلى البدل السنوي إن وجد.",
    "is_mandatory": true,
    "order_index": 2,
    "created_by": "legal_officer",
    "created_at": "2026-09-05T13:45:39.974Z",
    "updated_by": "legal_officer",
    "updated_at": "2026-09-05T13:45:39.974Z",
    "version": 1,
    "is_deleted": false
  },
  {
    "clause_id": "cls_1788615939974_uqer",
    "agreement_id": "6f96a289-7a19-4be0-bbac-946c04d87c74",
    "clause_number": "CLAUSE-03",
    "section_title": "الضمانات والكفالات",
    "clause_title": "كفالة حسن التنفيذ والالتزام",
    "clause_content": "يقدم المستثمر كفالة بنكية غير مشروطة بمبلغ (40000) دينار أردني تسري طيلة مدة التنفيذ.",
    "is_mandatory": true,
    "order_index": 3,
    "created_by": "legal_officer",
    "created_at": "2026-09-05T13:45:39.974Z",
    "updated_by": "legal_officer",
    "updated_at": "2026-09-05T13:45:39.974Z",
    "version": 1,
    "is_deleted": false
  },
  {
    "clause_id": "cls_1788615939975_czc5",
    "agreement_id": "6f96a289-7a19-4be0-bbac-946c04d87c74",
    "clause_number": "CLAUSE-04",
    "section_title": "الإنهاء والفسخ",
    "clause_title": "حالات إنهاء العقد ومصادرة الكفالة",
    "clause_content": "تخضع الاتفاقية لأحكام قانون الإدارة المحلية والأنظمة المعمول بها وتعليمات استثمار أموال البلديات.",
    "is_mandatory": true,
    "order_index": 4,
    "created_by": "legal_officer",
    "created_at": "2026-09-05T13:45:39.975Z",
    "updated_by": "legal_officer",
    "updated_at": "2026-09-05T13:45:39.975Z",
    "version": 1,
    "is_deleted": false
  },
