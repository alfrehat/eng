# =============================================================================
# نظام إدارة مديرية الأشغال والخدمات الهندسية - بلدية كفرنجة الجديدة
# نموذج إعدادات البيئة للتشغيل المؤسسي على الشبكة المحلية (.env.example)
# =============================================================================

# 1. إعدادات الشبكة والخادم (Server & LAN Binding)
HOST=0.0.0.0
PORT=3005
NODE_ENV=production

# 2. إعدادات الأمان والتشفير (Security & JWT Secret)
# تحذير: قم بتغيير هذا المفتاح إلى سلسلة عشوائية قوية عند التشغيل الفعلي
JWT_SECRET=kfranjah-secure-pki-key-2026

# 3. إعدادات قاعدة البيانات الأساسية (PostgreSQL Connection)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kafranjah_eng_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kafranjah_eng_db
DB_USER=postgres
DB_PASSWORD=your_secure_db_password_here

# 4. مسارات التخزين والأرشيف والنسخ الاحتياطي (Storage & Backups)
UPLOADS_DIR=./uploads
BACKUP_DIR=./backups
LOG_LEVEL=info
