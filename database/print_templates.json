  {
    "id": "TMPL-MTEUVMK7",
    "name": "كتاب إداري رسمي موجه (Official Letter) (نسخة مخصصة)",
    "module": "LETTER",
    "category_ar": "الكتب الرسمية والمخاطبات",
    "is_default": false,
    "orientation": "portrait",
    "updated_at": "2026-08-29T20:51:43.728Z",
    "description": "النموذج المعتمد للمخاطبات والكتب الرسمية الصادرة من مديرية الأشغال والخدمات الهندسية إلى الدوائر والمؤسسات.",
    "signatures_layout": "left",
    "signatures_config": [
      {
        "roleName": "رئيس اللجنة",
        "signLabel": "التوقيع والتاريخ",
        "position": "left"
      }
    ],
    "html_template": "\n                \n                \n                \n                \n                \n                \n                \n                \n                \n              \n              \n              \n              <div style=\"font-family:'Tajawal',sans-serif; line-height:1.8; font-size:1.05rem; color:#0f172a; padding:12px;\">\n  <div style=\"margin-bottom:20px; font-weight:bold;\">\n    <p style=\"margin:4px 0;\"><b>دولة / عطوفة / سعادة:</b> ${recipientName || 'المحترم'}</p>\n    <p style=\"margin:4px 0;\"><b>الموضوع:</b> ${subject || 'كتاب رسمي بخصوص مشاريع الأشغال والخدمات الهندسية'}</p>\n  </div>\n  <p style=\"text-indent:25px; text-align:justify; margin-bottom:16px;\">\n    تحية طيبة وبعد،،،<br>\n    بالإشارة إلى المعاملة رقم (<b>${refNumber}</b>) والمؤرخة بتاريخ (<b>${date}</b>) المتعلقة بـ <b>${details || 'أعمال ومشاريع البلدية'}</b>، نود إعلامكم بالآتي:\n  </p>\n  <div style=\"background:#f8fafc; border-right:4px solid #1e3a8a; padding:14px 18px; margin:18px 0; border-radius:6px; font-size:0.98rem; border:1px solid #e2e8f0; border-right-width:4px;\">\n    ${contentBody || 'تفاصيل نص القرار أو الكتاب الإداري الموجه بناءً على الفحوصات الفنية والكشوفات الميدانية المعتمدة.'}\n  </div>\n  <p style=\"text-align:justify; margin-top:20px;\">\n    يرجى التكرم بالاطلاع والتوجيه بما يلزم لاستكمال الإجراءات أصولاً.\n  </p>\n  <p style=\"text-align:center; margin-top:34px; font-weight:bold; color:#1e3a8a; font-size:1.05rem;\">\n    واقبلوا فائق الاحترام والتقدير،،،\n  </p>\n</div>\n            \n            \n            \n            \n              \n              \n              \n              \n              \n              \n              \n              \n              ",
    "header_config": {
      "use_custom": false,
      "countryName": "المملكة الأردنية الهاشمية",
      "ministryName": "وزارة الإدارة المحلية",
