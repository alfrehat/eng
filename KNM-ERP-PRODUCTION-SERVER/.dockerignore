# ==========================================
# .dockerignore
# قائمة حظر رفع الملفات المؤقتة والبيانات الحساسة لصور Docker للإنتاج
# ==========================================

# 1. Dependency Directories
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 2. Local Logs & Backup Files
logs/*.log
backups/
*.mdb
*.ldb

# 3. Environment & Local Credentials
.env
.env.local
.env.development
.env.production
*.pem
*.key
*.cert

# 4. Version Control & IDE Files
.git/
.gitignore
.agents/
.vscode/
.idea/
*.swp

# 5. Temporary & Cache Files
tmp/
temp/
coverage/
dist/
build/
.ds_store
Thumbs.db
